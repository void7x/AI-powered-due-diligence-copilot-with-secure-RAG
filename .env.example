# ============ AI Due Diligence Copilot — environment template ============
# Copy to .env (docker compose) and/or backend/.env (local dev), then fill in.

# ---- Database (PostgreSQL with pgvector for Docker; SQLite fallback works for dev) ----
# Docker compose service name is "db":
DATABASE_URL=postgresql+psycopg2://duediligence:duediligence@db:5432/duediligence
# Local (non-Docker) example:
# DATABASE_URL=postgresql+psycopg2://duediligence:duediligence@localhost:5432/duediligence

# ---- Security ----
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ---- AI (OpenAI). Leave key empty to run in deterministic offline mode. ----
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
# auto | openai | offline  (auto = openai when a key is set, otherwise offline)
AI_PROVIDER=auto
EMBEDDING_PROVIDER=auto

# ---- Files ----
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=50

# ---- RAG / chunking ----
CHUNK_SIZE_TOKENS=450
CHUNK_OVERLAP_TOKENS=60
RETRIEVAL_TOP_K=8
RERANKER=none

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- CORS (comma separated) ----
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Demo user auto-created on backend startup (dev convenience; disable in prod) ----
CREATE_DEMO_USER=true
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=demo1234
