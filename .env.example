# ============ AI Due Diligence Copilot — environment template ============
# Copy to .env (docker compose) and/or backend/.env (local dev), then fill in.

# ---- Database (PostgreSQL with pgvector for Docker; SQLite fallback works for dev) ----
POSTGRES_USER=duediligence
POSTGRES_PASSWORD=
POSTGRES_DB=duediligence
DATABASE_URL=postgresql+psycopg2://duediligence:<POSTGRES_PASSWORD>@db:5432/duediligence
# Local (non-Docker) example:
# DATABASE_URL=postgresql+psycopg2://duediligence:<POSTGRES_PASSWORD>@localhost:5432/duediligence

# ---- Security ----
SECRET_KEY=
# Required for staging/production. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ---- AI (OpenAI). Leave key empty to run in deterministic offline mode. ----
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
# auto | openai | offline  (auto = openai when a key is set, otherwise offline)
AI_PROVIDER=auto
EMBEDDING_PROVIDER=auto

# ---- Files ----
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=50

# ---- RAG / chunking ----
CHUNK_SIZE_TOKENS=450
CHUNK_OVERLAP_TOKENS=60
RETRIEVAL_TOP_K=8
RERANKER=none

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- CORS (comma separated) ----
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Demo user auto-created on backend startup (disabled by default) ----
# Set both CREATE_DEMO_USER=true and DEMO_PASSWORD to enable this convenience in local development.
CREATE_DEMO_USER=false
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=

# ---- Docker demo seed (disabled by default) ----
# Set true only for local/demo environments.
SEED_DEMO_DATA=false
